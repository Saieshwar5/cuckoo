# Copy to .env beside compose.yml on the server. Never commit .env.
#
# Everything the hub needs is derived from these in compose.yml, so a value
# appears here once. `docker compose config` shows the result.
#
# Nothing here is an AWS access key, and nothing here should be: the instance's
# IAM role gives the hub its access to S3. That only works if the containers
# can reach the instance metadata service, and Docker's bridge adds one hop —
# so the instance must be launched with a metadata hop limit of 2. See README,
# "The instance".

# The domain. It is the hub's identity, the base of every pair link, and the
# name Caddy fetches a certificate for.
SITE_DOMAIN=cuckoo.onl

# Image tags. deploy.sh rewrites these on every deploy; rollback is putting
# an earlier tag back and running `docker compose up -d`.
HUB_IMAGE=cuckoo-hub:CHANGEME
WELCOME_IMAGE=cuckoo-welcome:CHANGEME

# The region everything is in. Also what the AWS CLI reads during a backup.
AWS_REGION=ap-south-1

# The database: the RDS endpoint, and the master password set when the
# instance was created. DB_SSLMODE=require encrypts without checking who
# answered; verify-full needs the RDS certificate (README, "The database").
DB_HOST=cuckoo.CHANGEME.ap-south-1.rds.amazonaws.com
DB_PASSWORD=
# DB_USER=cuckoo
# DB_NAME=cuckoo
# DB_PORT=5432
# DB_SSLMODE=require

# Where uploaded files go: s3, or disk with compose.local.yml. The bucket is
# private; the hub reads and writes it with the instance's role, and serves
# every byte itself.
CUCKOO_BLOBS=s3
S3_BUCKET=cuckoo-media

# Signs every message the hub creates. 64 hex characters, required in
# production. Generate once: openssl rand -hex 32
#
# Keep a copy somewhere off this machine. There is one key and no rotation:
# losing it means every stored signature stops verifying, and it is not in the
# database backup.
SIGNING_KEY=

# How sign-in codes are delivered. "console" prints them to the hub's log,
# which is fine while only you sign in. "smtp" sends them through a provider,
# which is what everyone else needs; see "Mail" in README.md.
CUCKOO_MAIL=console

# With CUCKOO_MAIL=smtp. Port 587 (STARTTLS) or 465 (TLS); nothing else is
# accepted. The address must be one the provider has verified for this domain.
# CUCKOO_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# CUCKOO_SMTP_PORT=587
# CUCKOO_SMTP_FROM=hello@cuckoo.onl
# CUCKOO_SMTP_FROM_NAME=Cuckoo
# CUCKOO_SMTP_USERNAME=
# CUCKOO_SMTP_PASSWORD=

# debug | info | warn | error
CUCKOO_LOG_LEVEL=info

# Retention. A message and its files are deleted this many days after they
# were sent, oldest first; 0 keeps everything.
CUCKOO_RETENTION_DAYS=90

# How much uploaded media, still on a live message, one person and one agent
# may hold, in megabytes. Over budget, the oldest files go first.
CUCKOO_USER_MEDIA_BUDGET_MB=100
CUCKOO_AGENT_MEDIA_BUDGET_MB=1024

# true makes the sweeper log what it would delete and delete nothing.
CUCKOO_RETENTION_DRY_RUN=false

# The welcome agent: fill these in after creating it (README, "The welcome
# agent"), then uncomment the profile so compose starts it.
# WELCOME_HANDLE=welcome
# WELCOME_SECRET=bnd_sec_...
# COMPOSE_PROFILES=welcome

# Backups (backup.sh): the bucket the nightly dump is copied to. Usually the
# media bucket under a different prefix, or one of its own.
BACKUP_BUCKET=s3://cuckoo-backups

# Paths and ports. The defaults are right on the server; override them only
# to try the whole stack on a laptop.
# DATA_DIR=/data
# WWW_DIR=/srv/www
# HTTP_PORT=80
# HTTPS_PORT=443
