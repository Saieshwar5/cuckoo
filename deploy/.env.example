# Copy to .env beside compose.yml on the server. Never commit .env.
#
# Everything the hub needs is derived from these in compose.yml, so a value
# appears here once. `docker compose config` shows the result.

# The domain. It is the hub's identity, the base of every pair link, and the
# name Caddy fetches a certificate for.
SITE_DOMAIN=cuckoo.in

# Image tags. deploy.sh rewrites these on every deploy; rollback is putting
# an earlier tag back and running `docker compose up -d`.
HUB_IMAGE=cuckoo-hub:CHANGEME
WELCOME_IMAGE=cuckoo-welcome:CHANGEME

# Postgres. Generate once: openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs every message the hub creates. 64 hex characters, required in
# production. Generate once: openssl rand -hex 32
SIGNING_KEY=

# How sign-in codes are delivered. "console" prints them to the hub's log,
# which is fine while only you sign in; it is the only mode that exists.
CUCKOO_MAIL=console

# debug | info | warn | error
CUCKOO_LOG_LEVEL=info

# Retention. A message and its files are deleted this many days after they
# were sent, oldest first; 0 keeps everything.
CUCKOO_RETENTION_DAYS=90

# How much uploaded media, still on a live message, one person and one agent
# may hold, in megabytes. Over budget, the oldest files go first.
CUCKOO_USER_MEDIA_BUDGET_MB=100
CUCKOO_AGENT_MEDIA_BUDGET_MB=1024

# true makes the sweeper log what it would delete and delete nothing.
CUCKOO_RETENTION_DRY_RUN=false

# The welcome agent: fill these in after creating it (README, "The welcome
# agent"), then uncomment the profile so compose starts it.
# WELCOME_HANDLE=welcome
# WELCOME_SECRET=bnd_sec_...
# COMPOSE_PROFILES=welcome

# Backups (backup.sh): an rclone remote and bucket, e.g. spaces:cuckoo-backups
# BACKUP_REMOTE=

# Paths and ports. The defaults are right on the server; override them only
# to try the whole stack on a laptop.
# DATA_DIR=/data
# WWW_DIR=/srv/www
# HTTP_PORT=80
# HTTPS_PORT=443
