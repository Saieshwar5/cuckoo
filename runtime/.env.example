# Copy to .env and fill in. Never commit .env — it is gitignored.
#
#   cp .env.example .env
#   $EDITOR .env
#   npm start

# --- the model ----------------------------------------------------------
# Which of pi's providers to run models through: anthropic, fireworks,
# openai, groq, google, deepseek, openrouter, and a few dozen more.
RUNTIME_MODEL_PROVIDER=fireworks

# The key. RUNTIME_MODEL_API_KEY wins; the provider's own variable also
# works, so FIREWORKS_API_KEY is read when this is empty.
RUNTIME_MODEL_API_KEY=

# The model a template does not name. Ids are the provider's own.
#
#   fireworks: accounts/fireworks/models/deepseek-v4-flash-0731   cheap, 1M context
#              accounts/fireworks/models/deepseek-v4-pro-0813     stronger, 6x the price
#   anthropic: claude-sonnet-5 · claude-opus-5 · claude-haiku-4-5
RUNTIME_DEFAULT_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731

# Set to "fake" to run the whole service with a scripted model: no key, no
# spend, and every other part of the loop still exercised.
# RUNTIME_HARNESS=fake

# --- the database -------------------------------------------------------
# Its own Postgres. Never the hub's.
RUNTIME_DATABASE_URL=postgres://cuckoo:cuckoo@localhost:5433/cuckoo_runtime_dev?sslmode=disable

# 32 bytes, hex or base64. Encrypts binding secrets, and later people's app
# tokens. Not in the database, so a stolen dump is ciphertext.
#   openssl rand -hex 32
RUNTIME_SECRET_KEY=

# --- the hub ------------------------------------------------------------
RUNTIME_HUB_URL=http://localhost:8080

# Where the hub posts events. In production it must be HTTPS: the hub
# refuses private and loopback addresses. Empty means http://localhost:PORT,
# which the hub allows in development only.
RUNTIME_PUBLIC_URL=

RUNTIME_PORT=8081
