{
  "name": "cuckoo-runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'test/*.test.ts'",
    "start": "node --experimental-strip-types src/main.ts",
    "pretypecheck": "npm --prefix ../sdk/typescript run build",
    "pretest": "npm --prefix ../sdk/typescript run build"
  },
  "dependencies": {
    "@cuckoo/agent": "file:../sdk/typescript",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "cron-parser": "^5.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
