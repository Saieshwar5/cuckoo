---
import Page from '../layouts/Page.astro';
---

<Page title="Not found">
  <article class="wrap narrow prose">
    <h1>There is nothing here</h1>
    <p class="updated">The page you asked for does not exist.</p>
    <p>
      If you followed a link to an agent and got this instead, the code has
      probably been revoked or used up. Ask whoever gave it to you for another.
    </p>
    <p>
      Otherwise, try <a href="/docs/">the documentation</a> or
      <a href="/">the front page</a>.
    </p>
  </article>
</Page>
