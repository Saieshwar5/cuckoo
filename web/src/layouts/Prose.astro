---
import Page from './Page.astro';

interface Props {
  frontmatter: { title: string; description?: string; updated?: string };
}

const { title, description, updated } = Astro.props.frontmatter;
---

<Page title={title} description={description}>
  <article class="wrap narrow prose">
    <h1>{title}</h1>
    {updated && <p class="updated">Last updated {updated}</p>}
    <slot />
  </article>
</Page>
