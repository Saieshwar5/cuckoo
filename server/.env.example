# Copy to .env for local development: cp server/.env.example server/.env
#
# Every setting has a working default for `make up`, so an empty .env is fine.
# .env is gitignored — never commit real credentials.

# dev | test | prod
# In dev the X-Dev-User header also works; elsewhere only session tokens do.
CUCKOO_ENV=dev

# How sign-in codes are delivered. "console" prints them to the server log,
# which is what you want in dev; "smtp" sends them through a provider. Never
# assumed in prod: set it there deliberately.
CUCKOO_MAIL=console

# With CUCKOO_MAIL=smtp, the provider to send through. Port 587 upgrades with
# STARTTLS and 465 is TLS from the start; nothing else is accepted, because a
# sign-in code in the clear is one anyone on the path can read. The address
# must be one the provider has been told this hub may send from.
# CUCKOO_MAIL=smtp
# CUCKOO_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# CUCKOO_SMTP_PORT=587
# CUCKOO_SMTP_FROM=hello@cuckoo.onl
# CUCKOO_SMTP_FROM_NAME=Cuckoo
# CUCKOO_SMTP_USERNAME=
# CUCKOO_SMTP_PASSWORD=

CUCKOO_HTTP_ADDR=:8080

# Identifies this hub. Used for deep links and identifiers. Must be set
# explicitly when CUCKOO_ENV=prod; the production value lives in deploy/.env.
CUCKOO_HUB_DOMAIN=cuckoo.local

# Where people reach this hub from outside: the base of the links inside QR
# codes. http://localhost:8080 in dev; https://<hub domain> otherwise.
# CUCKOO_PUBLIC_URL=https://cuckoo.example.com

# Browser origins allowed to call the API, comma-separated. Any origin in
# dev by default (the app in a browser tab); none in prod unless listed.
# CUCKOO_CORS_ORIGINS=https://app.example.com

CUCKOO_DATABASE_URL=postgres://cuckoo:cuckoo@localhost:5433/cuckoo?sslmode=disable
CUCKOO_REDIS_URL=redis://localhost:6380/0

# Where uploaded files are kept: "disk", a folder here, or "s3", a bucket.
# The keys are the same either way, so moving between them is a copy of the
# folder and this setting. Production is s3; see deploy/README.md.
CUCKOO_BLOBS=disk
CUCKOO_MEDIA_DIR=./.data/media

# With CUCKOO_BLOBS=s3. There is no access key here on purpose: the SDK finds
# credentials the way every AWS tool does, which on the hub's machine is the
# instance's own role. An empty region leaves that to the SDK too.
# CUCKOO_S3_BUCKET=cuckoo-media
# CUCKOO_S3_REGION=ap-south-1

# debug | info | warn | error
CUCKOO_LOG_LEVEL=debug

CUCKOO_SHUTDOWN_TIMEOUT=15s
